{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toolspace-dashboard",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-27",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": [
      "/api/*"
    ]
  }
}
